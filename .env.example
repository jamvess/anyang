# Copy to .env (never commit .env). Cloud values live in Secret Manager / Vercel env.

# --- Supabase (from `supabase start` locally, or project settings in cloud) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # backend background jobs only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI providers ---
AI_PROVIDER=fake                      # fake | live   (tests always use fake)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=       # path to service-account json for local dev
ANTHROPIC_API_KEY=                    # fallback provider
MATHPIX_APP_ID=                       # only if PoC P1 says we need it
MATHPIX_APP_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
