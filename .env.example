# Copy to .env (never commit .env). Cloud values live in Secret Manager / Vercel env.

# --- App ---
APP_ENV=local                         # local | test | staging | production
# Browser origins allowed to call the API (exact match, comma-separated, never "*" or a trailing "/")
CORS_ALLOW_ORIGINS=http://localhost:3000
# Vercel previews of this project only (hash has no "-"); empty = off
CORS_ALLOW_ORIGIN_REGEX='^https://anyang-[a-z0-9]+-anyang4\.vercel\.app$'
# Path overrides; defaults are the repo-root folders. Only the Docker image sets these.
# CONFIG_DIR=./config
# PROMPTS_DIR=./prompts

# --- Supabase (from `supabase start` locally, or project settings in cloud) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # backend background jobs only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI providers ---
AI_PROVIDER=fake                      # fake | live   (tests always use fake)
AI_MODEL_OVERRIDE=                    # e.g. vertex:gemini-3.8-flash · replaces every tier's model (PoC/dev only)
GEMINI_API_KEY=                       # Google AI Studio key → provider "gemini" (PoC); free tier may train on data, see AI-07
GOOGLE_CLOUD_PROJECT=                 # set → provider "vertex" (config/ai.yaml default) · credentials from `gcloud auth application-default login`, no key file
GOOGLE_CLOUD_LOCATION=global          # Gemini 3 on Vertex AI (specs/features/ai/gemini-vertex.md §10)
ANTHROPIC_API_KEY=                    # fallback provider
MATHPIX_APP_ID=                       # only if PoC P1 says we need it
MATHPIX_APP_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
